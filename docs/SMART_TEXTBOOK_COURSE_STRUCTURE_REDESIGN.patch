diff --git a/src/features/courses/components/course-structure-directory.tsx b/src/features/courses/components/course-structure-directory.tsx
new file mode 100644
index 0000000..365c591
--- /dev/null
+++ b/src/features/courses/components/course-structure-directory.tsx
@@ -0,0 +1,63 @@
+"use client";
+
+import Link from "next/link";
+import { useState } from "react";
+import { ChevronRight, Folder, Search } from "lucide-react";
+import { CourseCatalogEditDialog, type CourseCatalogActionOptions } from "./course-catalog-action-dialogs";
+import type { CourseCatalogFolderRow } from "./course-catalog-tree/columns";
+
+export type StructureEntry = { key: string; title: string; context: string; href: string; active: boolean };
+
+export function CourseStructureDirectory({ entries, rootHref, rootActive }: { entries: StructureEntry[]; rootHref: string; rootActive: boolean }) {
+  const [query, setQuery] = useState("");
+  const visible = entries.filter(entry => `${entry.title} ${entry.context}`.toLocaleLowerCase().includes(query.trim().toLocaleLowerCase()));
+  return <aside className="min-w-0 rounded-xl border border-[var(--border)] bg-[var(--surface)] p-4 lg:self-start lg:sticky lg:top-4">
+    <h2 className="mb-3 text-sm font-semibold">课程目录</h2>
+    <label className="relative block">
+      <span className="sr-only">搜索分类或课程</span><Search aria-hidden="true" className="absolute left-3 top-3.5 size-4 text-[var(--foreground-muted)]" />
+      <input value={query} onChange={event => setQuery(event.target.value)} placeholder="搜索分类或课程" className="app-input mb-3 h-11 w-full min-w-0 rounded-lg border pl-9 pr-3 text-sm" />
+    </label>
+    <nav aria-label="分类与课程" className="max-h-64 space-y-1 overflow-y-auto lg:max-h-[65vh]">
+      <Link href={rootHref} aria-current={rootActive ? "page" : undefined} className={`flex min-h-11 items-center gap-2 rounded-lg px-3 text-sm ${rootActive ? "bg-[var(--surface-soft)] font-semibold" : "hover:bg-[var(--surface-soft)]"}`}><Folder aria-hidden="true" className="size-4" />全部分类</Link>
+      {visible.map(entry => <Link key={entry.key} href={entry.href} aria-current={entry.active ? "page" : undefined} className={`block rounded-lg border px-3 py-3 focus-visible:ring-2 focus-visible:ring-[var(--primary)] ${entry.active ? "border-[var(--primary)] bg-[var(--surface-soft)]" : "border-transparent hover:bg-[var(--surface-soft)]"}`}>
+        <span className="block break-words text-sm font-medium">{entry.title}</span><span className="mt-1 block break-words text-xs text-[var(--foreground-muted)]">{entry.context}</span>
+      </Link>)}
+      {!visible.length && <p role="status" className="p-3 text-sm text-[var(--foreground-muted)]">没有匹配的分类或课程</p>}
+    </nav>
+  </aside>;
+}
+
+export function CourseStructureItems({ rows, catalogRoute, folderParam, options, canManage }: {
+  rows: CourseCatalogFolderRow[]; catalogRoute: string; folderParam?: string; options: CourseCatalogActionOptions; canManage: boolean;
+}) {
+  const [query, setQuery] = useState("");
+  const [status, setStatus] = useState("all");
+  const visible = rows.filter(row => row.title.toLocaleLowerCase().includes(query.trim().toLocaleLowerCase()) && (status === "all" || (status === "draft" ? !row.isPublished : status === "locked" ? row.isLocked : row.isPublished && !row.isLocked)));
+  const join = catalogRoute.includes("?") ? "&" : "?";
+  return <div className="overflow-hidden rounded-xl border border-[var(--border)] bg-[var(--surface)]">
+    <div className="flex flex-wrap items-end gap-3 border-b border-[var(--border)] p-4">
+      <label className="grid min-w-0 flex-1 gap-1 text-xs text-[var(--foreground-muted)]">查找当前目录<input value={query} onChange={e => setQuery(e.target.value)} placeholder="输入名称" className="app-input h-11 w-full rounded-lg border px-3 text-sm" /></label>
+      <label className="grid gap-1 text-xs text-[var(--foreground-muted)]">开放状态<select aria-label="开放状态" value={status} onChange={e => setStatus(e.target.value)} className="app-input h-11 rounded-lg border px-3 text-sm"><option value="all">全部状态</option><option value="published">已上架且未锁定</option><option value="draft">未上架</option><option value="locked">已锁定</option></select></label>
+    </div>
+    <ul className="divide-y divide-[var(--border)]">
+      {visible.map(row => {
+        const detail = `${catalogRoute}${join}node=${row.kind}&id=${encodeURIComponent(row.id)}${folderParam ? `&folder=${encodeURIComponent(folderParam)}` : ""}#course-content`;
+        const href = row.canOpen ? `${catalogRoute}${join}folder=${encodeURIComponent(`${row.kind}:${row.id}`)}` : detail;
+        return <li key={row.key} className="flex flex-wrap items-center gap-3 p-4 sm:p-5">
+          <Link href={href} className="group flex min-w-0 basis-full items-center gap-3 rounded-md focus-visible:ring-2 focus-visible:ring-[var(--primary)] sm:flex-1 sm:basis-0">
+            <span className="flex size-10 shrink-0 items-center justify-center rounded-lg bg-[var(--surface-soft)] text-xs">{row.kindLabel}</span>
+            <span className="min-w-0"><span className="block break-words text-sm font-semibold group-hover:underline">{row.title}</span><span className="mt-1 block text-xs text-[var(--foreground-muted)]">{row.contentLabel}</span></span>
+            <ChevronRight aria-hidden="true" className="size-4 shrink-0 text-[var(--foreground-muted)]" />
+          </Link>
+          <span className="text-xs text-[var(--foreground-muted)]">{row.isPublished ? "已上架" : "未上架"}{row.isLocked ? " · 已锁定" : ""}</span>
+          <div className="flex items-center gap-2">
+            <Link href={detail} className="inline-flex min-h-11 items-center rounded-lg border border-[var(--border)] px-3 text-sm">查看资料</Link>
+            {canManage && <CourseCatalogEditDialog node={row.node} options={options} />}
+          </div>
+        </li>;
+      })}
+    </ul>
+    {!visible.length && <p role="status" className="p-8 text-center text-sm text-[var(--foreground-muted)]">{rows.length ? "没有符合当前条件的内容" : "当前目录还没有内容，可使用上方新建按钮添加。"}</p>}
+    <p aria-live="polite" className="border-t border-[var(--border)] px-4 py-3 text-xs text-[var(--foreground-muted)]">显示 {visible.length} / {rows.length} 项</p>
+  </div>;
+}
