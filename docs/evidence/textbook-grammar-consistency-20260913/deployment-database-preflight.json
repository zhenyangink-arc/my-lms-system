  "constraints": [
    {
      "table": "chapter_practice_bindings",
      "name": "chapter_practice_bindings_pkey",
      "definition": "PRIMARY KEY (id)"
    },
    {
      "table": "chapter_practice_bindings",
      "name": "chapter_practice_bindings_revision_check",
      "definition": "CHECK ((revision > 0))"
    },
    {
      "table": "chapter_practice_bindings",
      "name": "chapter_practice_bindings_snapshot_check",
      "definition": "CHECK ((jsonb_typeof(snapshot) = 'array'::text))"
    },
    {
      "table": "chapter_practice_bindings",
      "name": "chapter_practice_bindings_student_app_id_chapter_id_key",
      "definition": "UNIQUE (student_app_id, chapter_id)"
    },
    {
      "table": "chapter_practice_bindings",
      "name": "chapter_practice_bindings_student_app_id_fkey",
      "definition": "FOREIGN KEY (student_app_id) REFERENCES student_apps(id)"
    },
    {
      "table": "digital_textbook_nodes",
      "name": "digital_textbook_nodes_content_check",
      "definition": "CHECK ((jsonb_typeof(content) = 'object'::text))"
    },
    {
      "table": "digital_textbook_nodes",
      "name": "digital_textbook_nodes_estimated_minutes_check",
      "definition": "CHECK (((estimated_minutes >= 1) AND (estimated_minutes <= 90)))"
    },
    {
      "table": "digital_textbook_nodes",
      "name": "digital_textbook_nodes_module_id_fkey",
      "definition": "FOREIGN KEY (module_id) REFERENCES digital_textbook_modules(id) ON DELETE CASCADE"
    },
    {
      "table": "digital_textbook_nodes",
      "name": "digital_textbook_nodes_module_id_node_code_key",
      "definition": "UNIQUE (module_id, node_code)"
    },
    {
      "table": "digital_textbook_nodes",
      "name": "digital_textbook_nodes_module_id_sort_order_key",
      "definition": "UNIQUE (module_id, sort_order)"
    },
    {
      "table": "digital_textbook_nodes",
      "name": "digital_textbook_nodes_no_decorative_labels_check",
      "definition": "CHECK ((NOT (content ?| ARRAY['eyebrow'::text, 'typeLabel'::text, 'type_label'::text, 'interactionLabel'::text, 'interaction_label'::text])))"
    },
    {
      "table": "digital_textbook_nodes",
      "name": "digital_textbook_nodes_node_type_check",
      "definition": "CHECK ((node_type = ANY (ARRAY['learn'::text, 'practice'::text, 'mission'::text, 'review'::text])))"
    },
    {
      "table": "digital_textbook_nodes",
      "name": "digital_textbook_nodes_pkey",
      "definition": "PRIMARY KEY (id)"
    },
    {
      "table": "digital_textbook_nodes",
      "name": "digital_textbook_nodes_sort_order_check",
      "definition": "CHECK ((sort_order > 0))"
    },
    {
      "table": "digital_textbook_nodes",
      "name": "digital_textbook_nodes_title_check",
      "definition": "CHECK ((jsonb_typeof(title) = 'object'::text))"
    }
  ],
