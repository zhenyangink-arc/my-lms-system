      "no explicit Tool/Auth Admin mutation",
      "no new login flow",
      "no impersonation",
      "no magic-link relogin",
      "no new test user",
      "no profile/membership business writes",
      "no deliberately induced refresh for acceptance",
      "reasonable evidence attribution"
    ],
    "rowCountThreshold": null,
    "failureConditions": [
      "unknown Auth subject",
      "development actor session/refresh/identity change",
      "new auth.identity",
      "new unrelated auth.user",
      "profile/membership/tenant/permission/business write",
      "Tool Auth Admin call",
      "impersonation",
      "unexpected login issuance",
      "unattributable Auth change"
    ]
  },
