    "SUBJECT_AUTH_MUTATION": "Any development actor identity/session/refresh/login/JWT/profile/membership change attributable to acceptance; prohibited.",
    "OPERATOR_AUTH_MAINTENANCE": "Existing normal Platform Owner browser session maintained by existing Auth infrastructure; distinct from subject learning activity."
  },
  "gateA": {
    "name": "BUSINESS DOMAIN WRITE ISOLATION",
    "requiredDelta": 0,
    "attemptWriteDelta": 0,
    "progressWriteDelta": 0,
    "coverage": [
      "attempts",
      "node/activity-page/course/ebook/other lesson progress",
      "Activity/secrets/execution nodes/textbook versions/textbooks",
      "Teaching Script/version/objectives/frozen content",
      "canonical content",
      "tenant/profile/membership/permissions",
