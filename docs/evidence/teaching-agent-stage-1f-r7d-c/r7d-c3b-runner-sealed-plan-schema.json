  "checkRegistry": [
    {
      "id": "ledger-baseline/1",
      "parameters": "sealed count, full sorted expected version list/digest, full source-row prefix digest, expected latest, expected schema descriptor",
      "checks": "version/name/statements shape; PK(version); allowed ledger ACL/triggers/rules; all rows, count/duplicates/max/version-set/full source digest; no ledger DDL; retain full initial rows privately for exact pre/post comparison"
    },
    {
      "id": "migration-absent/1",
      "parameters": "version and followingAbsent versions from registered tuple",
      "checks": "000/001/002 predecessor/successor ordering, no already-applied version; local migration inventory discovers unexpected missing earlier pending version only to reject, never to execute"
    },
    {
      "id": "function-contract/1",
      "parameters": "signature from sealed object set, SHA256 pg_get_functiondef UTF8, owner/language/definer/config/volatility/parallel/leakproof",
      "checks": "catalog SELECT only; exact signature; no execution of target RPC"
    },
    {
      "id": "acl-contract/1",
      "parameters": "registered function signatures, exact sorted grantee/grantor/type/grantable entries and effective role booleans",
      "checks": "proacl plus aclexplode plus has_function_privilege; PUBLIC zero grantee handled separately; role flags and memberships including inherit/set/admin options"
    },
    {
      "id": "catalog-fingerprint/1",
      "parameters": "finite scope enum, expected manifest hash or captured-before reference; exact enumerated allowed delta",
      "checks": "OID-independent definitions/constraints/indexes/columns/policies/triggers/defaults/ACLs/memberships; checks can read pg catalogs only, never supplied SQL. All other functions/overloads/defaults unchanged for000."
    },
    {
      "id": "application-boundary/1",
      "parameters": "fixed live Build ID and runtime/launcher/source lock references",
      "checks": "local files only; Feature OFF/allowlists EMPTY; no PM2 commands or browser/Agent/Tool route"
    },
    {
      "id": "agent-completion-contract/1",
      "parameters": "sealed object-manifest state before/after001, exact expected hashes and ACLs",
      "checks": "reuse34b expected before/completion state authority and pinned function/trigger/CAS/fencing/cancellation inventories; no Agent Run/event inserts or function invocation in production checks"
    },
    {
      "id": "publication-contract/1",
      "parameters": "sealed manifest before/after002, exact objects/constraints/ACL and preserved wrappers/fences",
      "checks": "reuse34b before/completion/combined object authority; no published data creation, no publisher/RPC calls; pure metadata checks"
    },
    {
      "id": "scope-delta/1",
      "parameters": "exact allowed object changes and one ledger row",
      "checks": "inside transaction before COMMIT and separate RO verify; no extra tables/functions/ACLs beyond plan;000 exact target service grant removal only"
    }
  ],
  "additionalMandatorySemanticValidation": [
    "Exact known name/version/path/raw SHA/body-range/body SHA tuple equals independently reviewed registry entry; registry itself pinned by operator authorization, not writable user-provided arbitrary registry.",
    "Strict closed parameter schemas for every named check; no extra fields, SQL strings, import paths, expressions or arbitrary object references. Required check set cannot be removed by plan.",
    "All public CLI modes take a registered plan name only; registry path is fixed; path normalization/symlink/hardlink ownership checks prevent substitution.",
    "Verify full raw plan bytes against registry; never trust an internally self-declared hash.",
    "READY requires full prefix digest, exact target/check/baseline/backup/recovery/engine compatibility and separate operator authorization; null/TBD/fixture markers reject.",
    "No cyclic hash seal: plan references prior approval artifact; registry pins plan bytes; separate window-bound operator authorization pins both registry and plan+code package hashes.",
    "000 draft cannot run. Preflight on registered DRAFT may only produce baseline-capture receipt under explicit read authorization; it cannot promote/seal/edit plan. Subsequent reviewed plan revision is a new immutable file/approval.",
    "Only independently reviewed new registry/plan revisions may add future001/002 plans; engine unchanged, no auto chaining."
  ],
