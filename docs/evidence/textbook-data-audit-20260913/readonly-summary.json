    {
      "policies": [
        {
          "tablename": "chapter_practice_bindings",
          "policyname": "standard content managers inspect practice bindings",
          "roles": [
            "authenticated"
          ],
          "cmd": "SELECT",
          "qual": "current_user_can_manage_standard_question_bank()",
          "with_check": null
        },
        {
          "tablename": "digital_textbook_nodes",
          "policyname": "authenticated read textbook nodes",
          "roles": [
            "authenticated"
          ],
          "cmd": "SELECT",
          "qual": "(current_user_can_manage_standard_question_bank() OR (EXISTS ( SELECT 1\n   FROM (((digital_textbook_modules module\n     JOIN digital_textbook_chapters chapter ON ((chapter.id = module.chapter_id)))\n     JOIN digital_textbook_versions version ON ((version.id = chapter.version_id)))\n     JOIN digital_textbooks textbook ON ((textbook.id = version.textbook_id)))\n  WHERE ((module.id = digital_textbook_nodes.module_id) AND (chapter.status = 'published'::text) AND (version.status = 'published'::text) AND (textbook.status = 'published'::text) AND private.current_user_can_read_student_app(textbook.student_app_id)))))",
          "with_check": null
        },
        {
          "tablename": "digital_textbooks",
          "policyname": "authenticated read textbook catalog",
          "roles": [
            "authenticated"
          ],
          "cmd": "SELECT",
          "qual": "(current_user_can_manage_standard_question_bank() OR ((status = 'published'::text) AND private.current_user_can_read_student_app(student_app_id)))",
          "with_check": null
        },
        {
          "tablename": "growth_toolbox_grammar",
          "policyname": "application users read growth toolbox grammar",
          "roles": [
            "authenticated"
          ],
          "cmd": "SELECT",
          "qual": "(private.current_user_can_read_student_app(student_app_id) OR private.current_user_has_app_capability(private.current_tenant_id(), student_app_id, 'manage_content'::text))",
          "with_check": null
        }
      ]
    }
