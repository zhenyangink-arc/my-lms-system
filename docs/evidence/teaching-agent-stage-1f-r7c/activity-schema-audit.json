      "name": "digital_textbook_activities_instruction_check",
      "definition": "CHECK ((jsonb_typeof(instruction) = 'object'::text))"
    },
    {
      "table": "digital_textbook_activities",
      "name": "digital_textbook_activities_max_attempts_check",
      "definition": "CHECK (((max_attempts >= 1) AND (max_attempts <= 20)))"
