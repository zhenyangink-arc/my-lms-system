      "table": "digital_textbook_activities",
      "name": "digital_textbook_activities_activity_type_check",
      "definition": "CHECK ((activity_type = ANY (ARRAY['single_choice'::text, 'multiple_choice'::text, 'fill_blank'::text, 'ordering'::text, 'listening'::text, 'speaking'::text, 'writing'::text, 'self_check'::text])))"
