# Supabase（Project Settings > API）
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_publishable_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Cloudflare R2（仅服务端使用，切勿添加 NEXT_PUBLIC_ 前缀）
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=your_bucket_name

# R2 签名 URL 有效期，单位为秒；不填写时默认为 3600
R2_SIGNED_URL_EXPIRES_IN=3600

# Cloudflare Realtime SFU（仅服务端使用，App Secret 严禁添加 NEXT_PUBLIC_ 前缀）
CLOUDFLARE_REALTIME_APP_ID=
CLOUDFLARE_REALTIME_APP_SECRET=

# 口语 AI 陪练服务
CONVERSATION_AI_BASE_URL=https://percent-tech-whilst-beings.trycloudflare.com
CONVERSATION_AI_CHAT_PATH=/chat
# 语音版实时录音走浏览器直连 WebSocket；地址由 /api/conversation-practice/ai-experience/
# ws-ticket 在登录+配额校验通过后才下发给前端，因此这里刻意不加 NEXT_PUBLIC_ 前缀
# ——地址不会被打包进客户端 JS，隧道域名换了也只需重启服务，不需要重新构建发布。
CONVERSATION_AI_WS_URL=wss://percent-tech-whilst-beings.trycloudflare.com/ws
# 服务端转发/签发上述服务的凭证时携带的共享密钥；上游服务必须自行校验 HTTP 的
# Authorization 头部和 WS 握手 URL 里的 uid/exp/sig，才能真正防止绕过登录直接调用
# （仅设置这个变量不足以生效，需要上游配合）。
CONVERSATION_AI_SERVICE_TOKEN=
# 每个学生每24小时可发起的语音/图片陪练轮次上限，不填写时默认为 200。
CONVERSATION_AI_DAILY_MESSAGE_LIMIT=200

# Qwen 的 DASHSCOPE_API_KEY 不要写在这里；请仅保存到 Supabase Edge Function Secret。
# 多学科学习 Agent 只从 Supabase 私有配置与 Edge Function Secret 读取模型配置。
# 每位 Agent 的 provider/model 保存在 learning_agent_profile_secrets；API 密钥只保存为 Edge Secret。
# Qwen 可选：QWEN_AGENT_URL
# DeepSeek 必需：DEEPSEEK_API_KEY；可选：DEEPSEEK_BASE_URL
