+/* PG176_SESSION_READONLY_ROLES_EXPORTER/1: generated source carried by the
+ * versioned upstream patch. No libpq connection or SQL is performed here. */
+#define _GNU_SOURCE
+#include <errno.h>
+#include <fcntl.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <sys/stat.h>
+#include <unistd.h>
+
+#define PREFIX "/opt/teaching-agent/roles-exporter/pg17.6-v1"
+#define EXPORTER PREFIX "/bin/pg_dumpall"
+extern char **environ;
+static const char *keys[] = {
+    "TEACHING_AGENT_ACQUISITION_ID", "TEACHING_AGENT_INVOCATION_ID",
+    "TEACHING_AGENT_DISPATCH_SHA256", "TEACHING_AGENT_ARTIFACT_LOCK_SHA256",
+    "TEACHING_AGENT_SOURCE_TARGET_ID", "TEACHING_AGENT_ROLES_GATE_REGISTRY_SHA256",
+    "TEACHING_AGENT_ARGV_SHA256"
+};
+static const char *env_keys[] = {"HOME","LC_ALL","LD_LIBRARY_PATH","PATH","PGCLIENTENCODING","PGOPTIONS","PGSERVICEFILE","PGSYSCONFDIR"};
+static const char *env_values[] = {"/nonexistent","C",PREFIX "/lib",PREFIX "/bin:/usr/bin:/bin","UTF8","-c default_transaction_read_only=on -c statement_timeout=30000 -c lock_timeout=5000","/dev/null","/nonexistent"};
+
+static void fail(const char *code)
+{
+    fprintf(stderr, "%s\n", code);
+    exit(1);
+}
+
+static int hex(const char *s, size_t n)
+{
+    size_t i;
+    if (!s || strlen(s) != n) return 0;
+    for (i=0;i<n;i++) if (!((s[i]>='0' && s[i]<='9') || (s[i]>='a' && s[i]<='f'))) return 0;
+    return 1;
+}
+
+static int same(const struct stat *a, const struct stat *b)
+{
+    return a->st_dev == b->st_dev && a->st_ino == b->st_ino;
+}
+
+static void parent_gate(int fd, struct stat *st)
+{
+    struct stat named;
+    if (fstat(fd,st) || !S_ISDIR(st->st_mode) || (st->st_mode & 07777) != 0700 ||
+        st->st_uid != geteuid() || st->st_gid != getegid() ||
+        lstat("/proof", &named) || !S_ISDIR(named.st_mode) || !same(st,&named))
+        fail("ROLES_EXPORTER_RECEIPT_CHANNEL_FAILED");
+}
+
+int main(int argc, char **argv)
+{
+    char metadata[7][65];
+    int i, j, parent, fd, flags;
+    struct stat pst, again, st, named;
+    char *exec_argv[9];
+    char **e;
+    long maxfd;
+    if (getuid()==0 || geteuid()==0 || getgid()==0 || getegid()==0 ||
