+     * inherited keys (including image defaults) are discarded, never used. */
+    for (e=environ; *e; e++)
+    {
+        if (strncmp(*e,"TEACHING_AGENT_",15)) continue;
+        j=-1;
+        for (i=0;i<7;i++)
+            if (!strncmp(*e,keys[i],strlen(keys[i])) && (*e)[strlen(keys[i])]=='=') { j=i; break; }
+        if (j<0) fail("ROLES_EXPORTER_ARTIFACT_IDENTITY_FAILED");
+        { char **other;
+          for (other=e+1; *other; other++)
+              if (!strncmp(*other,keys[j],strlen(keys[j])) && (*other)[strlen(keys[j])]=='=')
+                  fail("ROLES_EXPORTER_ARTIFACT_IDENTITY_FAILED");
+        }
+    }
+    for (i=0;i<7;i++)
+    {
+        const char *v=getenv(keys[i]);
+        if (!hex(v,i<2?32:64)) fail("ROLES_EXPORTER_ARTIFACT_IDENTITY_FAILED");
+        strcpy(metadata[i],v);
+    }
+    if (strcmp(metadata[5],"124ebebaa8b0ae513d463e5b1443159a377620e419ad116c8324ce3198b0c5c4"))
+        fail("ROLES_EXPORTER_ARTIFACT_IDENTITY_FAILED");
+    if (clearenv()) fail("ROLES_EXPORTER_INTERNAL_FAILURE");
+    for(i=0;i<8;i++) if(setenv(env_keys[i],env_values[i],1)) fail("ROLES_EXPORTER_INTERNAL_FAILURE");
+    for(i=0;i<7;i++) if(setenv(keys[i],metadata[i],1)) fail("ROLES_EXPORTER_INTERNAL_FAILURE");
