+        fail("ROLES_EXPORTER_RECEIPT_CHANNEL_FAILED");
+    if (argc != 8 || strcmp(argv[1],"--no-password") || strcmp(argv[2],"-d") ||
+        strcmp(argv[4],"-l") || strcmp(argv[5],"postgres") ||
+        strcmp(argv[6],"--roles-only") || strcmp(argv[7],"--no-role-passwords"))
+        fail("ROLES_EXPORTER_ARGV_REQUIRED");
