+        st.st_nlink!=1 || st.st_size!=0 ||
+        fstatat(parent,"readonly.json",&named,AT_SYMLINK_NOFOLLOW) || !same(&st,&named))
+        fail("ROLES_EXPORTER_RECEIPT_CHANNEL_FAILED");
