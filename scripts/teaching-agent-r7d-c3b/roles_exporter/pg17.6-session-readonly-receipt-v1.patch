+static void
+roles_fail(const char *code)
+{
+    /* Authored diagnostics never include libpq errors, SQL or target values. */
+    fprintf(stderr, "%s\n", code);
+    exit(1);
+}
+
+static bool
+roles_hex(const char *s, size_t n)
+{
+    size_t i;
+    if (!s || strlen(s) != n) return false;
+    for (i = 0; i < n; i++)
+        if (!((s[i] >= '0' && s[i] <= '9') || (s[i] >= 'a' && s[i] <= 'f')))
+            return false;
+    return true;
+}
+
+static bool
+roles_atom(const char *s, bool host)
+{
+    size_t i, n = strlen(s);
+    if (n == 0 || n > (host ? 253 : 128)) return false;
+    for (i = 0; i < n; i++)
+        if (!((s[i] >= 'a' && s[i] <= 'z') || (s[i] >= 'A' && s[i] <= 'Z') ||
+              (s[i] >= '0' && s[i] <= '9') || s[i] == '-' || s[i] == '_' || s[i] == '.'))
+            return false;
+    if (host && (s[0] == '.' || s[0] == '-' || s[n-1] == '.' || s[n-1] == '-'))
+        return false;
+    return true;
+}
+
+static void
+roles_target_domain(const char *host, const char *user)
+{
+    const char *p, *suffix = ".pooler.supabase.com";
+    size_t i, n = strlen(host), end;
+    if (!strncmp(host,"uply-pa-source-",15))
+    {
+        if (!roles_hex(host+15,32) || strncmp(user,"postgres.",9) || !roles_hex(user+9,32))
+            roles_fail("ROLES_EXPORTER_ARGV_REQUIRED");
+        return; /* Actual owned network/labels/exact target are controller gates. */
+    }
+    if (strncmp(host,"aws-",4) || n <= strlen(suffix)+6 ||
+        strcmp(host+n-strlen(suffix),suffix) || strncmp(user,"postgres.",9) || strlen(user+9)!=20)
+        roles_fail("ROLES_EXPORTER_ARGV_REQUIRED");
+    p=host+4;
+    if (*p<'0' || *p>'9') roles_fail("ROLES_EXPORTER_ARGV_REQUIRED");
+    while (*p>='0' && *p<='9') p++;
+    if (*p++!='-') roles_fail("ROLES_EXPORTER_ARGV_REQUIRED");
+    end=n-strlen(suffix);
+    if ((size_t)(p-host)>=end) roles_fail("ROLES_EXPORTER_ARGV_REQUIRED");
+    for (; (size_t)(p-host)<end; p++)
+        if (!((*p>='a' && *p<='z') || (*p>='0' && *p<='9') || *p=='-'))
+            roles_fail("ROLES_EXPORTER_ARGV_REQUIRED");
+    for (i=9;user[i];i++)
+        if (!((user[i]>='a' && user[i]<='z') || (user[i]>='0' && user[i]<='9')))
+            roles_fail("ROLES_EXPORTER_ARGV_REQUIRED");
+}
+
+static void
+roles_profile(const char *p)
+{
+    int i;
+    char app[64];
+    /* Unique ordered fields with no escapes; approved host/user are bound by
+     * controller dispatch+target, not inferred from opaque sourceTargetId. */
+    for (i = 0; i < 12; i++)
+    {
+        size_t k = strlen(profile_keys[i]), n = 0;
+        if (strncmp(p, profile_keys[i], k) != 0 || p[k] != '=')
+            roles_fail("ROLES_EXPORTER_ARGV_REQUIRED");
+        p += k + 1;
+        if (*p++ != '\'') roles_fail("ROLES_EXPORTER_ARGV_REQUIRED");
+        while (*p && *p != '\'')
+        {
+            if (n >= 255 || *p == '\\' || *p == '\'' ||
+                (unsigned char)*p <= 32 || (unsigned char)*p >= 127)
+                roles_fail("ROLES_EXPORTER_ARGV_REQUIRED");
+            profile_values[i][n++] = *p++;
+        }
+        profile_values[i][n] = '\0';
+        if (n == 0 || *p++ != '\'')
+            roles_fail("ROLES_EXPORTER_ARGV_REQUIRED");
+        if (i < 11 ? *p++ != ' ' : *p != '\0')
+            roles_fail("ROLES_EXPORTER_ARGV_REQUIRED");
+        if (profile_constants[i] && strcmp(profile_values[i], profile_constants[i]) != 0)
+            roles_fail("ROLES_EXPORTER_ARGV_REQUIRED");
+    }
+    if (!roles_atom(profile_values[0], true) || !roles_atom(profile_values[3], false))
+        roles_fail("ROLES_EXPORTER_ARGV_REQUIRED");
+    roles_target_domain(profile_values[0],profile_values[3]);
+    snprintf(app, sizeof(app), "spa_roles_%s", bindings[1]);
+    if (strcmp(profile_values[9], app) != 0)
+        roles_fail("ROLES_EXPORTER_ARGV_REQUIRED");
+}
+
+static void
+roles_startup(int argc, char **argv)
+{
+    int flags, i;
+    struct stat st;
+    if (getuid() == 0 || geteuid() == 0 || getgid() == 0 || getegid() == 0 ||
+        getuid() != geteuid() || getgid() != getegid())
+        roles_fail("ROLES_EXPORTER_RECEIPT_CHANNEL_FAILED");
+    flags = fcntl(RECEIPT_FD, F_GETFD);
+    if (flags < 0 || fcntl(RECEIPT_FD, F_SETFD, flags | FD_CLOEXEC) < 0 ||
+        fstat(RECEIPT_FD, &st) < 0 || !S_ISREG(st.st_mode) ||
+        (st.st_mode & 07777) != 0600 || st.st_uid != geteuid() ||
+        st.st_gid != getegid() || st.st_nlink != 1 || st.st_size != 0 ||
+        (fcntl(RECEIPT_FD, F_GETFL) & O_ACCMODE) != O_WRONLY)
+        roles_fail("ROLES_EXPORTER_RECEIPT_CHANNEL_FAILED");
+    for (i = 0; i < 7; i++)
+    {
+        const char *s = getenv(binding_keys[i]);
+        if (!roles_hex(s, i < 2 ? 32 : 64))
+            roles_fail("ROLES_EXPORTER_ARTIFACT_IDENTITY_FAILED");
+        strcpy(bindings[i], s);
+    }
+    if (strcmp(bindings[5], REGISTRY_SHA) != 0 || strcmp(PG_VERSION, "17.6") != 0 || PG_VERSION_NUM != 170006)
+        roles_fail("ROLES_EXPORTER_ARTIFACT_IDENTITY_FAILED");
+    if (argc != 8 || strcmp(argv[0], EXPORTER_PATH) != 0 ||
+        strcmp(argv[1], "--no-password") || strcmp(argv[2], "-d") ||
+        strcmp(argv[4], "-l") || strcmp(argv[5], "postgres") ||
+        strcmp(argv[6], "--roles-only") || strcmp(argv[7], "--no-role-passwords"))
+        roles_fail("ROLES_EXPORTER_ARGV_REQUIRED");
+    roles_profile(argv[3]);
+    if (signal(SIGPIPE, SIG_IGN) == SIG_ERR)
+        roles_fail("ROLES_EXPORTER_INTERNAL_FAILURE");
+}
+
+static const char *
+roles_connection_status(PGconn *conn)
+{
+    if (PQstatus(conn) != CONNECTION_OK)
+        roles_fail("ROLES_EXPORTER_CONNECTION_REJECTED");
+    return "CONNECTION_OK"; /* label of the actual enum just checked */
+}
+
+static const char *
+roles_transaction_status(PGconn *conn)
+{
+    if (PQtransactionStatus(conn) != PQTRANS_IDLE)
+        roles_fail("ROLES_EXPORTER_MEASUREMENT_FAILED");
+    return "PQTRANS_IDLE";
+}
+
+static void
+roles_json_string(PQExpBuffer b, const char *s)
+{
+    const unsigned char *p;
+    appendPQExpBufferChar(b, '"');
+    for (p = (const unsigned char *)s; *p; p++)
+    {
+        if (*p == '"' || *p == '\\') appendPQExpBufferChar(b, '\\');
+        if (*p < 32 || *p >= 127) roles_fail("ROLES_EXPORTER_INTERNAL_FAILURE");
+        appendPQExpBufferChar(b, *p);
+    }
+    appendPQExpBufferChar(b, '"');
+}
+
+static int
+roles_decimal(const char *s, const char *code)
+{
+    unsigned long v = 0;
+    size_t i, n = strlen(s);
+    if (n == 0 || n > 10 || s[0] < '1' || s[0] > '9') roles_fail(code);
+    for (i = 0; i < n; i++)
+    {
+        if (s[i] < '0' || s[i] > '9') roles_fail(code);
+        v = v * 10 + (s[i] - '0');
+        if (v > INT_MAX) roles_fail(code);
+    }
+    return (int)v;
+}
+
+static void
+roles_setting_seconds(const char *s, int *milliseconds)
+{
+    char seconds[16];
+    size_t n = strlen(s);
+    if (n < 2 || n >= sizeof(seconds) || s[n-1] != 's')
+        roles_fail("ROLES_EXPORTER_READONLY_TIMEOUT_REJECTED");
+    memcpy(seconds, s, n-1); seconds[n-1] = '\0';
+    *milliseconds = roles_decimal(seconds, "ROLES_EXPORTER_READONLY_TIMEOUT_REJECTED");
+    if (*milliseconds > INT_MAX / 1000) roles_fail("ROLES_EXPORTER_READONLY_TIMEOUT_REJECTED");
+    *milliseconds *= 1000;
+}
+
+static void
+roles_measure_and_receipt(PGconn *conn)
+{
+    PGresult *init[3], *res;
+    PQExpBuffer b = createPQExpBuffer();
+    const char *cs[3], *ts[3], *mcs, *mts, *values[11];
+    const char *protocol, *cipher;
+    const char *expected[11] = {"on","on",NULL,"170006","postgres","postgres","postgres","UTF8","UTF8","30s","5s"};
+    int i, pid, version, ssl_in_use, statement_ms, lock_ms;
+    size_t off;
+    roles_connection_status(conn);
+    roles_transaction_status(conn);
+    for (i = 0; i < 3; i++)
+    {
+        roles_connection_status(conn);
+        roles_transaction_status(conn);
+        initializer_attempts++;
+        init[i] = PQexec(conn, initializer_sql[i]);
+        if (!init[i] || PQresultStatus(init[i]) != PGRES_COMMAND_OK ||
+            strcmp(PQcmdStatus(init[i]), "SET") != 0)
+            roles_fail("ROLES_EXPORTER_INITIALIZER_FAILED");
+        cs[i] = roles_connection_status(conn);
+        ts[i] = roles_transaction_status(conn);
+    }
+    roles_connection_status(conn);
+    roles_transaction_status(conn);
+    measurement_attempts++;
+    res = PQexec(conn, measurement_sql);
+    if (!res || PQresultStatus(res) != PGRES_TUPLES_OK || PQntuples(res) != 1 || PQnfields(res) != 11)
+        roles_fail("ROLES_EXPORTER_MEASUREMENT_FAILED");
+    mcs = roles_connection_status(conn);
+    mts = roles_transaction_status(conn);
+    for (i = 0; i < 11; i++)
+    {
+        if (PQftype(res, i) != 25 || PQfformat(res, i) != 0 || PQgetisnull(res, 0, i))
+            roles_fail("ROLES_EXPORTER_MEASUREMENT_FAILED");
+        values[i] = PQgetvalue(res, 0, i);
+        if ((size_t)PQgetlength(res, 0, i) != strlen(values[i]))
+            roles_fail("ROLES_EXPORTER_MEASUREMENT_FAILED");
+        if (expected[i] && strcmp(values[i], expected[i]) != 0)
+            roles_fail(i < 2 || i > 8 ? "ROLES_EXPORTER_READONLY_TIMEOUT_REJECTED" :
+                       "ROLES_EXPORTER_VERSION_IDENTITY_ENCODING_REJECTED");
+    }
+    pid = roles_decimal(values[2], "ROLES_EXPORTER_MEASUREMENT_FAILED");
+    version = roles_decimal(values[3], "ROLES_EXPORTER_VERSION_IDENTITY_ENCODING_REJECTED");
+    measured_server_version = version;
+    roles_setting_seconds(values[9], &statement_ms);
+    roles_setting_seconds(values[10], &lock_ms);
+    ssl_in_use = PQsslInUse(conn);
+    protocol = PQsslAttribute(conn, "protocol");
+    cipher = PQsslAttribute(conn, "cipher");
+    if (!ssl_in_use || !protocol || (strcmp(protocol,"TLSv1.2") && strcmp(protocol,"TLSv1.3")) ||
+        !cipher || strlen(cipher) == 0 || strlen(cipher) > 128)
+        roles_fail("ROLES_EXPORTER_TLS_REQUIRED");
+    for (i = 0; cipher[i]; i++)
+        if (!((cipher[i] >= 'A' && cipher[i] <= 'Z') || (cipher[i] >= 'a' && cipher[i] <= 'z') ||
+              (cipher[i] >= '0' && cipher[i] <= '9') || (i > 0 && (cipher[i] == '_' || cipher[i] == '-'))))
+            roles_fail("ROLES_EXPORTER_TLS_REQUIRED");
+
+    /* Lexicographic keys at every depth: canonical JSON, no protocol dump. */
+    appendPQExpBufferStr(b, "{\"bindings\":{");
+    { const int order[] = {0,6,3,2,1,5,4};
+      for (i = 0; i < 7; i++) {
+        if (i) appendPQExpBufferChar(b, ',');
+        roles_json_string(b, binding_names[order[i]]); appendPQExpBufferChar(b, ':');
+        roles_json_string(b, bindings[order[i]]);
+      }
+    }
+    appendPQExpBufferStr(b, "},\"component\":{\"name\":\"PG176_SESSION_READONLY_ROLES_EXPORTER\",\"upstreamVersion\":\"17.6\",\"version\":1},\"contract\":\"roles-exporter-measurement-receipt/1\",\"frontendTls\":{\"cipher\":");
+    roles_json_string(b, cipher);
+    appendPQExpBuffer(b, ",\"inUse\":%s,\"protocol\":", ssl_in_use ? "true" : "false");
+    roles_json_string(b, protocol);
+    appendPQExpBufferStr(b, "},\"initializerResults\":[");
+    for (i = 0; i < 3; i++)
+    {
+        if (i) appendPQExpBufferChar(b, ',');
+        appendPQExpBufferStr(b, "{\"commandTag\":"); roles_json_string(b, PQcmdStatus(init[i]));
+        appendPQExpBufferStr(b, ",\"connectionStatus\":"); roles_json_string(b, cs[i]);
+        appendPQExpBufferStr(b, ",\"operationId\":"); roles_json_string(b, initializer_ids[i]);
+        appendPQExpBufferStr(b, ",\"resultStatus\":"); roles_json_string(b, PQresStatus(PQresultStatus(init[i])));
+        appendPQExpBufferStr(b, ",\"sqlRawSha256\":"); roles_json_string(b, initializer_sha[i]);
+        appendPQExpBufferStr(b, ",\"transactionStatus\":"); roles_json_string(b, ts[i]);
+        appendPQExpBufferChar(b, '}');
+    }
+    appendPQExpBufferStr(b, "],\"measurement\":{\"actualTextValues\":[");
+    for (i = 0; i < 11; i++) { if (i) appendPQExpBufferChar(b, ','); roles_json_string(b, values[i]); }
+    appendPQExpBuffer(b, "],\"columnCount\":%d,\"connectionStatus\":", PQnfields(res)); roles_json_string(b, mcs);
+    appendPQExpBufferStr(b, ",\"formats\":[");
+    for (i = 0; i < 11; i++) appendPQExpBuffer(b, "%s%d", i ? "," : "", PQfformat(res, i));
+    appendPQExpBufferStr(b, "],\"isNull\":[");
+    for (i = 0; i < 11; i++) appendPQExpBuffer(b, "%s%s", i ? "," : "", PQgetisnull(res,0,i) ? "true" : "false");
+    appendPQExpBuffer(b, "],\"normalizedValues\":{\"backendPid\":%d,\"clientEncoding\":", pid); roles_json_string(b, values[8]);
+    appendPQExpBufferStr(b, ",\"currentUser\":"); roles_json_string(b, values[6]);
+    appendPQExpBufferStr(b, ",\"database\":"); roles_json_string(b, values[4]);
+    appendPQExpBufferStr(b, ",\"defaultTransactionReadOnly\":"); roles_json_string(b, values[1]);
+    /* Convert the measured, strictly gated setting text, never a startup value. */
+    appendPQExpBuffer(b, ",\"lockTimeoutMilliseconds\":%d,\"serverEncoding\":", lock_ms);
+    roles_json_string(b, values[7]);
+    appendPQExpBuffer(b, ",\"serverVersionNum\":%d,\"sessionUser\":", version); roles_json_string(b, values[5]);
+    appendPQExpBuffer(b, ",\"statementTimeoutMilliseconds\":%d,\"transactionReadOnly\":", statement_ms);
+    roles_json_string(b, values[0]);
+    appendPQExpBufferStr(b, "},\"queryRawSha256\":"); roles_json_string(b, measurement_sha);
+    appendPQExpBufferStr(b, ",\"resultStatus\":"); roles_json_string(b, PQresStatus(PQresultStatus(res)));
+    appendPQExpBuffer(b, ",\"rowCount\":%d,\"transactionStatus\":", PQntuples(res)); roles_json_string(b, mts);
+    appendPQExpBufferStr(b, ",\"typeOids\":[");
+    for (i = 0; i < 11; i++) appendPQExpBuffer(b, "%s%u", i ? "," : "", PQftype(res,i));
+    appendPQExpBufferStr(b, "]},\"measurementPoint\":\"AFTER_THREE_SESSION_SET_BEFORE_CATALOG\",\"rawResponseAvailable\":false,\"rawResponseSha256\":null,\"schemaVersion\":1,\"toolOperationCounts\":{");
+    appendPQExpBuffer(b, "\"fallbackCalls\":0,\"initializerSetAttempts\":%u,\"logicalPgconnObjects\":%u,\"measurementSelectAttempts\":%u,\"physicalConnectionAttempts\":null,\"physicalConnectionAttemptsStatus\":\"NOT_OBSERVABLE\",\"reconnectCalls\":0}}\n", initializer_attempts, logical_pgconn_objects, measurement_attempts);
+    if (PQExpBufferBroken(b) || b->len > RECEIPT_MAX)
+        roles_fail("ROLES_EXPORTER_OUTPUT_LIMIT");
+    for (off = 0; off < b->len; )
+    {
+        ssize_t n = write(RECEIPT_FD, b->data + off, b->len - off);
+        if (n < 0 && errno == EINTR) continue;
+        if (n <= 0) roles_fail("ROLES_EXPORTER_RECEIPT_WRITE_FAILED");
+        off += n;
+    }
+    if (fsync(RECEIPT_FD) < 0 || close(RECEIPT_FD) < 0)
+        roles_fail("ROLES_EXPORTER_RECEIPT_WRITE_FAILED");
+    for (i = 0; i < 3; i++) PQclear(init[i]);
+    PQclear(res);
+    destroyPQExpBuffer(b);
+}
 
