+    if(!same(&pst,&again) || fsync(parent)) fail("ROLES_EXPORTER_RECEIPT_CHANNEL_FAILED");
+    if(dup2(fd,3)<0) fail("ROLES_EXPORTER_RECEIPT_CHANNEL_FAILED");
+    flags=fcntl(3,F_GETFD);
+    if(flags<0 || fcntl(3,F_SETFD,flags & ~FD_CLOEXEC)<0)
+        fail("ROLES_EXPORTER_RECEIPT_CHANNEL_FAILED");
+    /* parent can originally be FD3: dup2 already closed it; never close the
+     * replacement FD3. Drop every unrelated descriptor before exec. */
+    maxfd=sysconf(_SC_OPEN_MAX);
+    if(maxfd<0 || maxfd>2147483647L) fail("ROLES_EXPORTER_INTERNAL_FAILURE");
+    for(i=4;i<maxfd;i++) close(i);
+    exec_argv[0]=(char *)EXPORTER;
+    for(i=1;i<8;i++) exec_argv[i]=argv[i];
+    exec_argv[8]=NULL;
+    execv(EXPORTER,exec_argv);
+    fail("ROLES_EXPORTER_ARTIFACT_IDENTITY_FAILED");
+    return 1;
+}
